{
  "name": "ghost-cursor-patchright",
  "version": "1.0.4",
  "description": "Move your mouse like a human in patchright/playwright, or generate realistic movements on any 2D plane",
  "repository": "https://github.com/codeiva11/Ghost-Cursor-Patchright",
  "main": "lib/spoof.js",
  "types": "lib/spoof.d.ts",
  "exports": {
    ".": {
      "types": "./lib/spoof.d.ts",
      "default": "./lib/spoof.js"
    },
    "./patchright": {
      "types": "./lib/spoof.d.ts",
      "default": "./lib/spoof.js"
    }
  },
  "peerDependencies": {
    "patchright": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "patchright": {
      "optional": true
    }
  },
  "scripts": {
    "prepare": "husky",
    "build": "tsc -p tsconfig.build.json",
    "debug": "ts-node src/__debug__/browser-debug.ts",
    "lint": "yarn ts-standard --fix",
    "test": "jest",
    "validate": "yarn lint && yarn build"
  },
  "keywords": [
    "bezier-curve",
    "mouse-movement",
    "botting",
    "patchright",
    "playwright"
  ],
  "author": "Xetera",
  "license": "ISC",
  "files": [
    "lib/**/*"
  ],
  "dependencies": {
    "@types/bezier-js": "4",
    "bezier-js": "^6.1.4",
    "debug": "^4.4.3"
  },
  "devDependencies": {
    "@swc/core": "^1.15.24",
    "@swc/jest": "^0.2.39",
    "@types/debug": "^4.1.13",
    "@types/jest": "30",
    "@types/node": "^25.5.2",
    "husky": "9",
    "jest": "30",
    "patchright": "latest",
    "ts-node": "^10.9.2",
    "ts-standard": "12",
    "typescript": "6"
  },
  "jest": {
    "verbose": true,
    "modulePathIgnorePatterns": [
      "./lib",
      "./src/test.ts"
    ],
    "reporters": [
      "default",
      "github-actions"
    ],
    "transform": {
      "^.+\\.(t|j)sx?$": "@swc/jest"
    }
  },
  "packageManager": "yarn@4.13.0"
}
